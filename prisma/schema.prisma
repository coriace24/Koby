generator client {
  provider      = "prisma-client-js"
  // "windows" ships the query engine the desktop (.exe) package needs
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  createdAt    DateTime      @default(now())
  analyses     Analysis[]
  settings     UserSettings?
}

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  aiModel               String? // null = server default (ANTHROPIC_MODEL env)
  defaultVacancyPct     Float   @default(5)
  defaultClosingCostPct Float   @default(1)
  defaultInterestRate   Float   @default(6.5)
  defaultLoanTermYears  Int     @default(30)
  defaultDownPaymentPct Float   @default(25)
  capRateBands          String  @default("6,7,8") // comma-separated percents for the valuation matrix
  whatIfRentDelta       Float   @default(500) // $/month step for rent sensitivity

  // Report branding
  companyName    String?
  companyContact String? // phone / email / license line shown on reports
  brandColor     String? // hex accent color for reports, e.g. #1a365d
}

// One row per AI invocation — the usage & cost record billing is built on.
model AiRun {
  id           String   @id @default(cuid())
  userId       String
  analysisId   String?
  mode         String // "extraction" | "summary"
  model        String
  inputTokens  Int
  outputTokens Int
  costUsd      Float // estimated from the model's price card
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

// Credit movements; balance = sum(delta). Enforcement is off until billing is enabled.
model CreditLedger {
  id        String   @id @default(cuid())
  userId    String
  delta     Float // + purchase/grant, - consumption
  reason    String // "grant" | "ai_run" | "purchase" | "adjustment"
  createdAt DateTime @default(now())

  @@index([userId])
}

// Public, revocable read-only links to an analysis report.
model ShareLink {
  id         String    @id @default(cuid()) // the token in the URL
  analysisId String
  analysis   Analysis  @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
}

model Analysis {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Step 1: property inputs
  address       String
  purchasePrice Float // the OFFER amount used for underwriting
  askingPrice   Float? // seller's asking price, for offer-vs-asking comparison
  units         Int
  propertyType  String
  yearBuilt     Int
  occupancy     Float // percent, 0-100

  // Acquisition costs (cash-needed calculation)
  closingCosts  Float? // defaults to settings.defaultClosingCostPct% of offer at creation
  carryingCosts Float?

  // Financing assumptions
  loanAmount    Float
  interestRate  Float // annual percent
  loanTermYears Int
  downPayment   Float

  // Optional inputs
  renovationBudget Float?
  targetReturn     Float? // target cash-on-cash percent
  strategy         String?
  notes            String?

  // Value-add assumptions (editable)
  marketRentPerUnit    Float? // assumed achievable market rent $/unit/month
  renoCostPerUnit      Float?
  renoUnitCount        Int?
  renoRentIncrease     Float? // expected $/unit/month increase after renovation
  exitCapRate          Float? // percent, for value impact + sale price at exit
  vacancyAssumption    Float? // percent override used in stabilized projections

  // Hold-period projection assumptions
  holdYears        Int? // investment horizon; projection computed when set with exitCapRate
  rentGrowthPct    Float? // annual income growth, percent
  expenseGrowthPct Float? // annual expense growth, percent
  saleCostPct      Float? // selling costs as percent of sale price

  // Manual deal-calculator inputs (JSON strings) — used when no documents are analyzed yet
  unitMix            String? // [{label, count, rent, fee}] — per-unit-type monthly rents
  manualOpex         String? // {propertyTaxes, insurance, ...} — annual estimates
  otherIncomeMonthly Float? // laundry/parking/etc, $/month (manual mode)

  // AI outputs (JSON strings)
  extraction String? // extracted income/expense line items with sources + data flags
  aiSummary  String? // overview, opportunities, risks, summary text

  status    String   @default("DRAFT") // DRAFT | DOCUMENTS_UPLOADED | ANALYZING | NEEDS_REVIEW | COMPLETED | FAILED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents  Document[]
  shareLinks ShareLink[]
}

model Document {
  id         String   @id @default(cuid())
  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  filename  String
  mimeType  String
  docType   String // RENT_ROLL | T12 | OFFERING_MEMO | TAX | INSURANCE | UTILITY | LEASE | FINANCIAL | OTHER
  size      Int
  path      String
  createdAt DateTime @default(now())
}
