DATABASE_URL="file:./dev.db"
# Secret used to sign session cookies. Change in production.
SESSION_SECRET="dev-secret-change-me-please-0123456789"
# Anthropic API key for AI document extraction and analysis.
# Without a key, uploads and underwriting math still work, but AI analysis will
# return an error asking you to configure the key.
ANTHROPIC_API_KEY=""
# Optional model override
ANTHROPIC_MODEL="claude-opus-5"
# Pay-per-use scaffolding (hosting-day switches — leave as-is for local use):
# When "true", each AI run consumes 1 credit and runs are blocked at 0 credits.
# Credits are granted via the CreditLedger table (Stripe integration comes at hosting time).
BILLING_ENFORCED="false"
# If set, new registrations must supply this invite code (leave empty for open signup).
INVITE_CODE=""
